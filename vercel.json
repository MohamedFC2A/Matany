{
  "framework": "vite",
  "functions": {
    "api/generate-image.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/telemetry/incident",
      "destination": "/api/telemetry-incident"
    },
    {
      "source": "/api/elevenlabs/:action*",
      "destination": "/api/elevenlabs"
    },
    {
      "source": "/api/fathom-its/chat",
      "destination": "/api/fathom-its-chat"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/((?!api/|assets/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}

